<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch screen theme — shows the splash background while Flutter initialises -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Normal theme used once Flutter has drawn its first frame -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Razorpay checkout activity theme -->
    <style name="Checkout" parent="Theme.AppCompat.Light.NoActionBar"/>
</resources>
